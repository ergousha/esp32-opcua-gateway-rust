# TRANSITIONAL, and only for the release build of the private firmware
# bucket: gateways deployed before the platform SDK have their fallback WiFi
# compiled in, and the next image moves it into NVS (src/config.rs). After
# that build, nothing reads this file: WiFi is written at the bench with
# `ergo commission --wifi-ssid ... --wifi-psk-env ...`.
#
# `cfg.toml` is gitignored so the password never ends up in the repo.
[esp32-opcua-gateway]
wifi_ssid = "your-ssid"
wifi_psk = "your-password"
