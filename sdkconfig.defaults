# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K).
# TLS handshake + MQTT config + serde_json parse main task'ta calisiyor; 16K guvenli.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384

# Increase a bit these stack sizes as they are also a bit too small by default
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# You might have to increase this further if you spawn your own Rust threads
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# --- Flash partition layout ---
# partitions.csv is the SINGLE source of truth. It is copied into the esp-idf-sys
# CMake project dir by the ESP_IDF_GLOB_* vars in .cargo/config.toml, so the table
# generated here is byte-identical to the one espflash writes (the runner in
# .cargo/config.toml passes --partition-table partitions.csv).
# Previously this said CONFIG_PARTITION_TABLE_TWO_OTA_LARGE=y, which declared
# 1700K app slots while espflash flashed 4M slots — two divergent tables.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y

# --- OTA safety ---
# Without this, esp_ota_mark_app_valid_cancel_rollback() (ota::mark_valid) is a
# no-op and a bad OTA image bricks the device permanently. With it, the bootloader
# marks a freshly OTA'd slot PENDING_VERIFY and reverts to the previous slot if the
# app reboots before confirming itself. telemetry::run() confirms only after the
# MQTT session to AWS IoT is established, which is the health gate.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- W5500 Ethernet over SPI (esp_eth -> lwIP netif) ---
# Saf-Rust w5500-ll yerine ESP-IDF surucusu; TCP/IP + mbedTLS + MQTT icin sart.
CONFIG_ETH_USE_SPI_ETHERNET=y
CONFIG_ETH_SPI_ETHERNET_W5500=y

# --- MQTT over TLS (AWS IoT Core, mutual auth) ---
# TLS handshake ve provisioning yaniti (cert+key) icin biraz daha stack/heap.
CONFIG_MQTT_TASK_STACK_SIZE=6144
CONFIG_ESP_TLS_INSECURE=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# Free the mbedTLS record buffers between records instead of holding them for
# the life of the connection. Measured on hardware: with them pinned, the OPC
# UA session leaves so little heap that 1 kB allocations fail during a
# reconfiguration and the driver thread aborts. IN_CONTENT_LEN stays at 16384
# deliberately — shrinking it would risk choking on a large TLS record from
# AWS IoT, which carries Jobs and OTA as well as telemetry.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
